// Schema da Levva
// Reflete a estrutura definida no plano de negócio:
// 3 perfis (pai / motorista / admin), planos (Básico / Frota / Destaque),
// leads com repasse manual, e verificação documental como pré-requisito.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  PAI
  MOTORISTA
  ADMIN
}

enum PlanoTipo {
  BASICO
  FROTA
}

enum StatusAssinatura {
  ATIVA
  PENDENTE
  VENCIDA
  CANCELADA
}

enum StatusAprovacao {
  PENDENTE
  APROVADO
  REPROVADO
}

enum StatusLead {
  AGUARDANDO
  ENCAMINHADO
  EM_NEGOCIACAO
  FECHADO
  NAO_FECHOU
}

enum StatusTicket {
  ABERTO     // aguardando resposta do admin
  RESPONDIDO // admin respondeu, bola com o pai/motorista
  FECHADO
}

model User {
  id        String   @id @default(cuid())
  role      Role
  nome      String
  // E-mail é o identificador de login dos três papéis.
  email     String   @unique
  senhaHash String
  // Telefone segue obrigatório pra pai e motorista (contato via WhatsApp),
  // mas admin não precisa de um — por isso opcional no schema.
  telefone  String?  @unique
  createdAt DateTime @default(now())
  // Invalida sessões antigas quando a senha muda (ver lib/auth.ts).
  senhaAlteradaEm DateTime @default(now())
  // Desativada pelo admin: login passa a falhar (ver autenticar() em
  // lib/auth.ts) e, se for motorista, some da busca (ver /api/busca).
  // Não apaga nada — é reversível.
  ativo     Boolean  @default(true)

  // Aceite dos Termos de Uso (ver /termos) — obrigatório desde que essa
  // coluna existe; contas criadas antes disso ficam null (não há aceite
  // retroativo automático). termosVersao guarda qual redação foi aceita,
  // pra rastrear se precisa pedir aceite de novo quando os termos mudarem.
  termosAceitosEm DateTime?
  termosVersao    String?

  // Relação 1:1 com o perfil específico do papel
  pai       Pai?
  motorista Motorista?
  admin     Admin?

  sessoes   Sessao[]
  tokensRecuperacao TokenRecuperacao[]

  // Chamados de suporte: pai e motorista abrem (ticketsAbertos), qualquer um
  // dos três papéis pode escrever mensagem numa thread (mensagensTicket) —
  // é o admin respondendo ou o próprio autor completando o chamado.
  ticketsAbertos  Ticket[]         @relation("TicketAutor")
  mensagensTicket TicketMensagem[]
}

model Admin {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id])
  userId String @unique
}

// Sessão ativa. O JWT no cookie carrega o id dela, então dá pra derrubar
// uma sessão específica (logout, troca de senha, remoção de acesso) sem
// esperar o token expirar.
model Sessao {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiraEm  DateTime
  criadaEm  DateTime @default(now())
  userAgent String?
  ip        String?

  @@index([userId])
}

// Token de redefinição de senha, enviado por e-mail. Guardamos só o hash —
// o valor em claro existe apenas dentro do link que o usuário recebe.
model TokenRecuperacao {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String   @unique
  usado     Boolean  @default(false)
  expiraEm  DateTime
  criadoEm  DateTime @default(now())

  @@index([userId])
}

// Tentativas de login falhas, pra travar força bruta. Fica no banco em vez
// de memória porque o container reinicia e a trava não pode reiniciar junto.
model TentativaLogin {
  id         String   @id @default(cuid())
  chave      String   // email normalizado ou "ip:<endereco>"
  criadaEm   DateTime @default(now())

  @@index([chave, criadaEm])
}

// Limite de taxa genérico pra rota que não é login (busca, recuperação de
// senha) — mesma ideia de TentativaLogin, mas separado por `escopo` pra não
// misturar contagem de coisas diferentes na mesma chave. Ver lib/rate-limit.ts.
model LimiteTaxa {
  id       String   @id @default(cuid())
  escopo   String
  chave    String
  criadaEm DateTime @default(now())

  @@index([escopo, chave, criadaEm])
}

// ---------- PERFIL DO PAI ----------
model Pai {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String   @unique
  endereco  String
  // Opcionais de propósito: o geocoding depende de serviço externo gratuito
  // que nem sempre reconhece o endereço. Perder o lead por causa disso seria
  // pior do que guardar o endereço só como texto.
  lat       Float?
  lng       Float?
  createdAt DateTime @default(now())

  // Exigidos pelo Asaas pra criar cobrança (ver lib/asaas.ts) — preenchidos
  // só quando o admin gera a primeira cobrança pra esse pai, não no
  // cadastro (nem todo pai chega a fechar contrato).
  cpfCnpj         String?
  asaasCustomerId String?

  filhos     Filho[]
  leads      Lead[]
  avaliacoes Avaliacao[]
  contratos  Contrato[]
}

model Filho {
  id       String @id @default(cuid())
  pai      Pai    @relation(fields: [paiId], references: [id])
  paiId    String
  nome     String
  escola   Escola @relation(fields: [escolaId], references: [id])
  escolaId String

  leads Lead[]
}

model Escola {
  id       String  @id @default(cuid())
  nome     String
  bairro   String
  cidade   String  @default("Salvador")
  lat      Float
  lng      Float

  filhos       Filho[]
  transportadores MotoristaEscola[]
}

// Resultado de geocoding já consultado, guardado por endereço normalizado.
// O Nominatim pede no máximo 1 consulta por segundo e bloqueia por IP —
// e endereços se repetem MUITO dentro de um mesmo bairro. Guardamos também
// as buscas sem resultado, pra não insistir no mesmo endereço inválido.
model GeocodeCache {
  id         String   @id @default(cuid())
  consulta   String   @unique
  lat        Float?
  lng        Float?
  encontrado Boolean
  fonte      String?
  criadoEm   DateTime @default(now())
}

// ---------- PERFIL DO MOTORISTA / TRANSPORTADOR ----------
model Motorista {
  id                 String            @id @default(cuid())
  user               User              @relation(fields: [userId], references: [id])
  userId             String            @unique
  fotoRosto          String?
  cnhNumero          String
  cnhCategoria       String
  cnhDocUrl          String?
  cursoDocUrl        String?
  antecedentesDocUrl String?
  cursoTransporte    Boolean           @default(false)
  antecedentesOk     Boolean           @default(false)
  statusAprovacao    StatusAprovacao   @default(PENDENTE)
  // Guardados quando statusAprovacao vira REPROVADO (ver rota de reprovar) —
  // motivo aparece pro próprio motorista no painel, e reprovadoEm trava o
  // botão de "solicitar nova análise" por 30 dias (ver
  // /api/motorista/solicitar-reanalise). Ambos somem quando aprovado.
  motivoReprovacao   String?
  reprovadoEm        DateTime?
  anosExperiencia    Int               @default(0)
  temMonitor         Boolean           @default(false)
  precoMin           Int? // em centavos
  precoMax           Int? // em centavos
  destaqueAtivo      Boolean           @default(false)
  // Coletada no cadastro (ver bodySchema em app/api/motoristas/route.ts), mas
  // até aqui era validada e descartada — o valor nunca chegava no banco.
  cidade             String            @default("Salvador")
  // Preferência do motorista pra quem paga a taxa da Mova — pré-preenche o
  // diálogo de fechar contrato (ele ainda pode trocar por contrato), em vez
  // de sempre começar em MOTORISTA. Ver app/motorista/(painel)/perfil.
  pagadorTaxaPadrao  PagadorTaxa       @default(MOTORISTA)
  // Fotos/vídeo do próprio motorista pro perfil público — diferente dos
  // documentos (CNH etc.), que são privados. Servidos por /api/midia, sem
  // exigir sessão (ver lib/storage.ts).
  fotos              String[]          @default([])
  videoUrl           String?
  createdAt          DateTime          @default(now())

  veiculos    Veiculo[]
  escolas     MotoristaEscola[]
  leads       Lead[]
  avaliacoes  Avaliacao[]
  assinatura  Assinatura?
  contratos   Contrato[]
  extras      MotoristaExtra[]
  saques      SolicitacaoSaque[]

  // Regra de enquadramento no plano Frota (ver /lib/plano.ts):
  // múltiplos veículos OU 3+ escolas atendidas -> Frota
  // 1 veículo E até 2 escolas -> Básico
  //
  // Assinatura acima é o modelo antigo (mensalidade fixa pra ficar listado),
  // mantido como está por enquanto. Contrato é o novo modelo em avaliação
  // (taxa da Mova só em cima de contrato fechado, ver lib/financeiro.ts) —
  // os dois convivem até uma decisão de aposentar o primeiro.
}

model Veiculo {
  id          String    @id @default(cuid())
  motorista   Motorista @relation(fields: [motoristaId], references: [id])
  motoristaId String
  placa       String
  modelo      String
  capacidade  Int
  fotoUrl     String?
}

model MotoristaEscola {
  id          String    @id @default(cuid())
  motorista   Motorista @relation(fields: [motoristaId], references: [id])
  motoristaId String
  escola      Escola    @relation(fields: [escolaId], references: [id])
  escolaId    String

  @@unique([motoristaId, escolaId])
}

model Assinatura {
  id          String            @id @default(cuid())
  motorista   Motorista         @relation(fields: [motoristaId], references: [id])
  motoristaId String            @unique
  plano       PlanoTipo
  destaque    Boolean           @default(false)
  status      StatusAssinatura  @default(PENDENTE)
  valorCentavos Int
  proximaCobranca DateTime?
  createdAt   DateTime          @default(now())
}

// ---------- LEAD (o coração do repasse manual) ----------
model Lead {
  id          String     @id @default(cuid())
  pai         Pai        @relation(fields: [paiId], references: [id])
  paiId       String
  filho       Filho      @relation(fields: [filhoId], references: [id])
  filhoId     String
  motorista   Motorista  @relation(fields: [motoristaId], references: [id])
  motoristaId String
  status      StatusLead @default(AGUARDANDO)
  motivoNaoFechou String?
  createdAt   DateTime   @default(now())
  encaminhadoEm DateTime?

  // Uma solicitação fechada (van contratada) pode gerar no máximo uma
  // avaliação — é o que aponta que o pai realmente contratou aquele
  // motorista, em vez de qualquer um poder avaliar qualquer um.
  avaliacao Avaliacao?
  // Idem pro contrato: só existe quando o motorista marca FECHADO
  // informando valor/periodicidade (ver POST /api/motorista/leads/[id]/fechar).
  contrato  Contrato?
}

model Avaliacao {
  id          String    @id @default(cuid())
  motorista   Motorista @relation(fields: [motoristaId], references: [id])
  motoristaId String
  // Quem avaliou e a partir de qual solicitação — sem isso não dava pra
  // saber se a avaliação veio de uma família de verdade nem impedir
  // duplicata pro mesmo fechamento.
  pai         Pai       @relation(fields: [paiId], references: [id])
  paiId       String
  lead        Lead      @relation(fields: [leadId], references: [id])
  leadId      String    @unique
  nota        Int // 1-5
  comentario  String?
  // Só entra na média pública (ver /api/busca) e aparece na página do
  // motorista depois que um admin aprova em /admin/depoimentos.
  moderado    Boolean   @default(false)
  createdAt   DateTime  @default(now())
}

// Chamado simples (tipo ticket), não chat ao vivo. Pai e motorista abrem;
// qualquer mensagem nova reabre o chamado se estava FECHADO (ver
// POST /api/tickets/[id]/mensagens) — reflete que a dúvida voltou.
model Ticket {
  id        String       @id @default(cuid())
  autor     User         @relation("TicketAutor", fields: [autorId], references: [id])
  autorId   String
  assunto   String
  status    StatusTicket @default(ABERTO)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  mensagens TicketMensagem[]
}

model TicketMensagem {
  id        String   @id @default(cuid())
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  ticketId  String
  autor     User     @relation(fields: [autorId], references: [id])
  autorId   String
  corpo     String
  createdAt DateTime @default(now())
}

enum StatusExtra {
  PENDENTE  // motorista contratou, aguardando confirmação de pagamento pelo admin
  ATIVO
  CANCELADO
}

// Serviço extra que o motorista contrata avulso, fora da comissão por
// contrato fechado (ver Contrato) e fora da mensalidade antiga (ver
// Assinatura). `tipo` é string solta (não enum) de propósito: "DESTAQUE"
// é o único hoje, mas rastreador e outros devem entrar sem precisar de
// migração pra cada um.
//
// Fase 1, como Contrato: só registra a contratação dentro da plataforma.
// Cobrança de verdade via Asaas é decisão futura.
model MotoristaExtra {
  id            String        @id @default(cuid())
  motorista     Motorista     @relation(fields: [motoristaId], references: [id])
  motoristaId   String
  tipo          String
  valorCentavos Int
  periodicidade Periodicidade
  status        StatusExtra   @default(PENDENTE)
  createdAt     DateTime      @default(now())
  canceladoEm   DateTime?
}

enum Periodicidade {
  MENSAL
  TRIMESTRAL
  ANUAL
}

enum PagadorTaxa {
  MOTORISTA // desconta do valor que o motorista recebe
  PAI       // repassada: soma no valor cobrado da família
}

// Modelo de comissão em avaliação (ver lib/financeiro.ts): sem mensalidade
// pra ficar listado, a Mova só ganha uma taxa percentual em cima do valor
// combinado de cada contrato fechado de verdade. Nasce junto com o
// Lead virando FECHADO — não existe Contrato sem lead fechado, nem lead
// fechado sem Contrato (ver POST /api/motorista/leads/[id]/fechar).
//
// Fase 1: só registra o acordo dentro da plataforma (valor, taxa,
// periodicidade). Cobrança de verdade (Asaas, split de pagamento) é uma
// fase futura, ainda não decidida.
model Contrato {
  id          String        @id @default(cuid())
  lead        Lead          @relation(fields: [leadId], references: [id])
  leadId      String        @unique
  motorista   Motorista     @relation(fields: [motoristaId], references: [id])
  motoristaId String
  pai         Pai           @relation(fields: [paiId], references: [id])
  paiId       String

  // Valor combinado entre motorista e família, por ciclo de cobrança
  // (mensal/trimestral/anual) — não é o valor total do contrato.
  valorCentavos Int
  periodicidade Periodicidade

  // Taxa congelada no momento do fechamento: mudar TAXA_MOVA_PERCENTUAL
  // depois não altera contratos já fechados, só os próximos.
  taxaPercentual Int
  pagadorTaxa    PagadorTaxa
  taxaCentavos   Int

  createdAt DateTime @default(now())
  cobrancas Cobranca[]
}

// Um registro por ciclo pago (mensal/trimestral/anual) de um Contrato — não
// existe cobrança automática ainda (sem Asaas), o motorista marca manualmente
// quando recebe. É o que dá pra calcular "próximo vencimento" e "em dia vs.
// aguardando" em /motorista/financeiro, sem precisar de job agendado.
model Cobranca {
  id            String   @id @default(cuid())
  contrato      Contrato @relation(fields: [contratoId], references: [id])
  contratoId    String
  // Primeiro dia do ciclo que essa cobrança cobre — não é a data em que foi
  // marcada como paga (essa é createdAt).
  competencia   DateTime
  valorCentavos Int
  createdAt     DateTime @default(now())

  // Preenchidos quando a cobrança nasce de uma cobrança gerada no Asaas
  // (ver lib/asaas.ts) em vez de marcada manualmente pelo motorista.
  // `paga` só é false nesse caso — uma marcação manual já representa
  // dinheiro recebido, então nasce paga (default true preserva as linhas
  // criadas antes dessa coluna existir).
  asaasPaymentId String?   @unique
  linkPagamento  String?
  paga           Boolean   @default(true)
  pagaEm         DateTime?

  // Uma cobrança paga (Asaas) e ainda sem saque vinculado está "disponível"
  // pro motorista sacar (ver lib/financeiro.ts saldoDisponivelMotorista).
  // Vincular a uma SolicitacaoSaque reserva o valor pra aquele pedido —
  // pedir de novo antes do primeiro ser pago não soma o mesmo valor duas
  // vezes, porque a cobrança já não conta mais como "livre".
  solicitacaoSaque   SolicitacaoSaque? @relation(fields: [solicitacaoSaqueId], references: [id])
  solicitacaoSaqueId String?
}

enum StatusSaque {
  PENDENTE
  PAGO
}

// Pedido do motorista pra sacar o que já foi pago pelo pai via Asaas mas
// ainda não foi repassado (Pix manual, fora do Asaas — ver lib/asaas.ts).
// O valor é travado no momento do pedido (soma das cobranças livres na
// hora), não recalculado depois — assim o motorista sabe exatamente quanto
// vai receber, mesmo que uma cobrança nova seja paga enquanto isso.
model SolicitacaoSaque {
  id            String      @id @default(cuid())
  motorista     Motorista   @relation(fields: [motoristaId], references: [id])
  motoristaId   String
  valorCentavos Int
  status        StatusSaque @default(PENDENTE)
  createdAt     DateTime    @default(now())
  pagoEm        DateTime?

  cobrancas Cobranca[]
}

enum AmbienteAsaas {
  SANDBOX
  PRODUCAO
}

// Linha única (id fixo "asaas") com a conta Asaas usada pra cobrança —
// existe pra não deixar a chave de API hardcoded no código/.env: trocar de
// conta Asaas vira uma tela em /admin/configuracoes, não um deploy. A chave
// nunca fica em texto puro no banco (ver lib/cripto.ts); contaNome/contaEmail
// são só um cache do último "testar conexão", pra mostrar no admin qual
// conta está configurada sem precisar decifrar a chave de novo.
// Uma linha por ambiente (PRODUCAO e SANDBOX podem conviver, cada uma com
// sua própria chave/webhook/conta testada) — o admin cadastra as duas em
// /admin/configuracoes e escolhe qual fica `ativo`, sem precisar apagar
// e recolar a chave toda vez que quiser alternar entre elas pra testar.
// Só uma linha tem ativo=true por vez (garantido em lib/asaas.ts).
model ConfiguracaoAsaas {
  id            AmbienteAsaas @id
  apiKeyCifrada String?
  contaNome     String?
  contaEmail    String?
  testadoEm     DateTime?
  // Token que o Asaas manda de volta em cada webhook (header
  // asaas-access-token) — gerado por nós ao registrar o webhook via API
  // (ver lib/asaas.ts configurarWebhookAsaas), cifrado do mesmo jeito que
  // a chave de API. Um por ambiente, já que sandbox e produção são contas
  // Asaas diferentes com webhooks registrados separadamente.
  webhookTokenCifrada String?
  ativo               Boolean  @default(false)
  atualizadoEm        DateTime @updatedAt
}
