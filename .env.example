# ---- Banco de dados (Postgres) ----
# No docker-compose.yml o host é "db" (nome do serviço); localmente, "localhost".
DATABASE_URL="postgresql://levva:SUA_SENHA_AQUI@localhost:5432/levva"
POSTGRES_PASSWORD="SUA_SENHA_AQUI"

# ---- Sessão (login por OTP) ----
# Gere um valor aleatório forte, ex.: openssl rand -base64 48
JWT_SECRET=""

# ---- WhatsApp Cloud API (envio do código OTP) ----
# Sem essas duas, o código cai só no console do servidor (ok pra testar,
# não serve pra produção). Credenciais em developers.facebook.com/apps.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_ID=""

# ---- Geocoding ----
# Usa Nominatim (OpenStreetMap) por padrão, sem precisar de chave.
# Não precisa configurar nada aqui pra isso funcionar.

# ---- App ----
NODE_ENV="production"
