# ---- Banco de dados (Postgres) ----
# No docker-compose.yml o host é "db" (nome do serviço); localmente, "localhost".
DATABASE_URL="postgresql://levva:SUA_SENHA_AQUI@localhost:5432/levva"
POSTGRES_PASSWORD="SUA_SENHA_AQUI"

# ---- Sessão ----
# Gere um valor aleatório forte, ex.: openssl rand -base64 48
JWT_SECRET=""

# ---- URL pública do app ----
# Usada pra montar os links dentro dos e-mails (redefinição de senha etc).
APP_URL="https://seu-dominio.com.br"

# ---- E-mail (SMTP) ----
# Sem isso a redefinição de senha NÃO funciona: a mensagem cai no log do
# servidor com um aviso, e ninguém recupera acesso sozinho.
# Serve qualquer provedor: Zoho, Brevo, Amazon SES, Gmail com senha de app.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Levva <contato@seu-dominio.com.br>"

# ---- Documentos enviados pelos motoristas ----
# Pasta FORA de public/ — CNH e antecedentes são dado pessoal e só saem
# por /api/documentos, que confere sessão e papel. No container o
# docker-compose já aponta pra /app/uploads (volume levva_uploads).
UPLOAD_DIR="./uploads"

# ---- Conta de administrador ----
# Usadas só pelo script `npm run criar-admin`, não pelo app em execução.
# ADMIN_EMAIL="voce@exemplo.com"
# ADMIN_SENHA="TroqueEssaSenha1"
# ADMIN_NOME="Administração Levva"

# ---- Geocoding ----
# Usa Nominatim (OpenStreetMap) por padrão, sem precisar de chave.

# ---- App ----
NODE_ENV="production"
