# Normaliza texto no repositório com LF
* text=auto eol=lf

# Arquivos que RODAM no Linux (VPS) — precisam obrigatoriamente de LF
*.sh          text eol=lf
Dockerfile    text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
nginx.conf    text eol=lf
.env.example  text eol=lf

# Binários — nunca converter
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
